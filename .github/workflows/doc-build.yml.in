name: Documentation
run-name: doc
on: push
jobs:
  sphinx:
    uses: hpcflow/github-support/.github/workflows/doc-build-impl.yml@main
    with:
      artifact-root-name: {{ executable_name }}
      ref: {% raw %}${{ github.sha }}{% endraw %}
      python-version: "3.13"
      poetry-version: "2.1.3"
      install-args: --without pyinstaller
